# HEATSHIELD AI — Backend Environment Configuration Placeholder
# Note: Keep this file on the backend server; never commit actual secrets to version control.

# 1. AI Assistant Configuration (Optional)
# Configure either GEMINI_API_KEY or OPENAI_API_KEY to activate live AI answers.
GEMINI_API_KEY=
OPENAI_API_KEY=

# 2. Google Earth Engine (GEE) Configuration (Required for Real Satellite Data Pipeline)
# Provides authentic Landsat 8/9 Level-2 ST_B10 surface temperature,
# Sentinel-2 Level-2A surface reflectance (NDVI, NDWI, NDBI), and MODIS daily/8-day LST.
EE_PROJECT_ID=
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY=
# Or specify path to a service account JSON credentials file:
EE_KEY_FILE=
